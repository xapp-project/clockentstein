<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.x.clockenstein.calendar" path="/org/x/clockenstein/calendar/">
    <key name="default-view" type="s">
      <default>'month'</default>
    </key>
    <key name="window-width" type="i">
      <default>1100</default>
      <range min="640" max="32768"/>
    </key>
    <key name="window-height" type="i">
      <default>750</default>
      <range min="460" max="32768"/>
    </key>
  </schema>
</schemalist>
